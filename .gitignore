/target-v2/
/dist/
**/*.rs.bk
**/.cargo-build.lock
Cargo.lock.bak

.claude/

# Perf-test output. Each run of explore_leak_source / explore_perf_*
# writes a timestamped log to perf-runs/. Useful locally; the
# committed evidence is summarized in docs/ongoing.md.
/perf-runs/

# Stray cargo target that sometimes shows up under ueforge/cpp/.
ueforge/cpp/target/

# GPL-3 prior-art clones used only as research reference.
# Their source has its own .git history and must not be redistributed in our MIT tree.
horsey-mod/research/prior-art/

# Raw output the obenseuer research tests write on every run. The
# findings are in the docs; rerun the test to get the output again.
obenseuer-mod/docs/*.txt

# C# shim build output (dotnet build artifacts)
unityforge/cs-shim-*/bin/
unityforge/cs-shim-*/obj/
