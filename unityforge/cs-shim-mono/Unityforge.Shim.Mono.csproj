<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Unityforge.Shim.Mono</AssemblyName>
    <Version>0.1.0</Version>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RootNamespace>Unityforge.Shim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Common sources linked from cs-shim-common (shared with the IL2CPP shim). -->
    <Compile Include="..\cs-shim-common\Bridge.cs">
      <Link>Common\Bridge.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\GenerationLoader.cs">
      <Link>Common\GenerationLoader.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\HarmonyBridge.cs">
      <Link>Common\HarmonyBridge.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\Logger.cs">
      <Link>Common\Logger.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\InputBridge.cs">
      <Link>Common\InputBridge.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\HandleArg.cs">
      <Link>Common\HandleArg.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\TypeCache.cs">
      <Link>Common\TypeCache.cs</Link>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
    <!-- BepInEx major version: 5 (monolithic BepInEx.dll) or 6
         (split into BepInEx.Core + BepInEx.Unity.Mono). Pass
         -p:BepInExVersion=6 for Unity 6 games. -->
    <BepInExVersion Condition="'$(BepInExVersion)' == ''">5</BepInExVersion>
    <DefineConstants Condition="'$(BepInExVersion)' == '6'">$(DefineConstants);BEPINEX6</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      BepInEx (Mono) + HarmonyX + Unity references. Adjust
      HintPaths via -p:BepInExDir / -p:UnityDir when building
      against a specific install. Pass -p:BepInExVersion=6 for
      BepInEx 6 (split assemblies).
    -->
    <Reference Include="BepInEx" Condition="'$(BepInExDir)' != '' AND '$(BepInExVersion)' == '5'">
      <Private>false</Private>
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Core" Condition="'$(BepInExDir)' != '' AND '$(BepInExVersion)' == '6'">
      <Private>false</Private>
      <HintPath>$(BepInExDir)\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono" Condition="'$(BepInExDir)' != '' AND '$(BepInExVersion)' == '6'">
      <Private>false</Private>
      <HintPath>$(BepInExDir)\core\BepInEx.Unity.Mono.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony" Condition="'$(BepInExDir)' != ''">
      <Private>false</Private>
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine" Condition="'$(UnityDir)' != ''">
      <Private>false</Private>
      <HintPath>$(UnityDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="'$(UnityDir)' != ''">
      <Private>false</Private>
      <HintPath>$(UnityDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Condition="'$(UnityDir)' != ''">
      <Private>false</Private>
      <HintPath>$(UnityDir)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
